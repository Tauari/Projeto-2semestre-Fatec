# Copie este arquivo para .env (ele fica fora do git) e preencha. Nunca coloque uma chave real aqui.
# Variáveis de ambiente valem mais que o .env.

# Provedor de IA: heuristica (padrão, só regras), ollama (modelo local) ou groq (API do Groq).
AURORA_IA_PROVEDOR=groq

# Chave criada em https://console.groq.com. O texto dos relatos é enviado ao Groq depois da limpeza por
# regras (telefone, placa, número de casa, e-mail, documento, perfil e nome dito como "se chama X";
# outros nomes podem passar). Combine com o Observatório antes de usar com relatos reais.
AURORA_GROQ_API_KEY=

# Modelo do Groq (opcional; o padrão está em backend/config.py).
# AURORA_GROQ_MODELO=
