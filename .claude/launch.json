{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aurora-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--port", "8000", "--no-access-log"],
      "port": 8000
    },
    {
      "name": "aurora-estatico",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8080", "--bind", "127.0.0.1"],
      "port": 8080
    }
  ]
}
